{
  "compilerOptions": {
    "target": "es2024",
    "module": "nodenext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "rewriteRelativeImportExtensions": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": { "@curvesel/core": ["./packages/core/src/index.ts"] }
  },
  "include": [
    "packages/*/src",
    "packages/*/test",
    "playground",
    "demo",
    "e2e",
    "bench",
    "scripts",
    "playwright.config.ts"
  ],
  // Type-checked against the packed packages by `check:pack`, after the build.
  "exclude": ["scripts/check-pack.sample.ts"]
}
